---
// The agent kit in one theme: its demo in a frame, with switches for the
// screen width and the color mode, and the commands that install it.
import type { GetStaticPaths } from "astro"

import Command from "@/components/Command.astro"
import Layout from "@/layouts/Base.astro"
import { kitUrls, themes, type ThemeView } from "@/lib/themes"

export const getStaticPaths: GetStaticPaths = () =>
  themes.map((theme) => ({ params: { theme: theme.slug }, props: { theme } }))

const { theme } = Astro.props as { theme: ThemeView }
const urls = kitUrls(theme.slug)
const widths = [
  { label: "Desktop", value: "100%" },
  // The frame's 1px border on each side is added to the screen's width.
  { label: "Tablet", value: "770px" },
  { label: "Phone", value: "377px" },
]
const toggle =
  "label rounded-sm border border-foreground px-4 py-2 hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-ring aria-pressed:bg-foreground aria-pressed:text-background"
---

<Layout
  title={`Agent kit in ${theme.name}: blocks for agent interfaces | Strict`}
  description={`A tool call, an approval, a streaming answer and its sources as React blocks, written out in the ${theme.name} theme and checked against it.`}
  theme={theme.slug}
>
  <section class="border-b border-border">
    <div class="mx-auto grid max-w-page gap-8 px-4 py-16 md:grid-cols-12 md:px-8">
      <p class="label text-muted-foreground md:col-span-12">
        <a href="/kit" class="underline underline-offset-4 hover:text-foreground">Agent kit</a>
        <span> / </span>
        <a href={`/themes/${theme.slug}`} class="underline underline-offset-4 hover:text-foreground"
          >{theme.name}</a
        >
      </p>
      <h1 class="text-h1 md:col-span-12 md:text-display">The agent kit in {theme.name}</h1>
      <div class="flex flex-col gap-4 md:col-span-6">
        <p>
          Four blocks for an agent's side of a conversation, in {theme.name}'s spacing, type
          and colors. The page below is built from the same files the command installs. The
          shop and the order in it are made up.
        </p>
        <p>
          <a href={urls.build} class="label text-link underline underline-offset-4">
            Open the page alone
          </a>
        </p>
      </div>
      <div class="min-w-0 md:col-span-12">
        <Command command={theme.kit.command} label={`Add all four blocks and the ${theme.name} theme`} />
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-4 px-4 py-8 md:px-8" aria-label="Preview">
    <div class="flex flex-wrap items-center justify-between gap-4">
      {/* A phone is narrower than every width on offer, so the switch shows from a tablet up. */}
      <div role="group" aria-label="Screen width" class="hidden flex-wrap gap-2 md:flex">
        {
          widths.map((width, index) => (
            <button
              type="button"
              class={toggle}
              data-width={width.value}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {width.label}
            </button>
          ))
        }
      </div>
      <div role="group" aria-label="Color mode" class="flex flex-wrap gap-2">
        <button type="button" class={toggle} data-mode-choice="light" aria-pressed="true">
          Light
        </button>
        <button type="button" class={toggle} data-mode-choice="dark" aria-pressed="false">
          Dark
        </button>
      </div>
    </div>
    <div class="rounded-md border border-border bg-card p-2 md:p-4">
      <div
        class="mx-auto max-w-full overflow-hidden rounded-sm border border-border"
        style="width:100%"
        data-stage
        data-strict-ignore
      >
        <iframe
          src={urls.build}
          title={`The agent kit, built with ${theme.name}`}
          class="block w-full bg-background"
          style="height:80svh"></iframe>
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-page flex-col gap-8 px-4 py-16 md:px-8">
    <h2 class="label border-t border-foreground pt-4 text-muted-foreground">One block at a time</h2>
    <ul class="flex flex-col">
      {
        theme.kit.blocks.map((block) => (
          <li class="grid gap-4 border-t border-border py-8 md:grid-cols-12 md:gap-8">
            <div class="flex flex-col gap-2 md:col-span-4">
              <h3 class="font-heading text-h2">{block.title}</h3>
              <p class="text-muted-foreground">{block.description}</p>
            </div>
            <div class="min-w-0 md:col-span-8">
              <Command command={block.command} label={`Add the ${block.title.toLowerCase()} block and the theme`} />
            </div>
          </li>
        ))
      }
    </ul>
    <p class="max-w-measure text-muted-foreground">
      In a project that already has {theme.name}, the second address in a command is enough.
      The files land in <code>components/agent</code>, and they are yours to change.
    </p>
  </section>
</Layout>

<script>
  import { holdMode } from "@/lib/frames"

  const stage = document.querySelector<HTMLElement>("[data-stage]")
  const frame = stage?.querySelector("iframe")
  let mode: "light" | "dark" = "light"
  const apply = frame ? holdMode(frame, () => mode) : () => {}

  const press = (chosen: HTMLButtonElement, all: NodeListOf<HTMLButtonElement>) => {
    for (const button of all) button.setAttribute("aria-pressed", String(button === chosen))
  }

  const widths = document.querySelectorAll<HTMLButtonElement>("[data-width]")
  for (const button of widths) {
    button.addEventListener("click", () => {
      if (stage) stage.style.width = button.dataset.width ?? "100%"
      press(button, widths)
    })
  }

  const modes = document.querySelectorAll<HTMLButtonElement>("[data-mode-choice]")
  for (const button of modes) {
    button.addEventListener("click", () => {
      mode = button.dataset.modeChoice === "dark" ? "dark" : "light"
      apply()
      press(button, modes)
    })
  }
</script>
