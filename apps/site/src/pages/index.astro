---
import Command from "@/components/Command.astro"
import MoreTile from "@/components/MoreTile.astro"
import PromptThumb from "@/components/PromptThumb.astro"
import SectionHeader from "@/components/SectionHeader.astro"
import ThemeCard from "@/components/ThemeCard.astro"
import { ThemePreview } from "@/components/ThemePreview"
import Layout from "@/layouts/Base.astro"
import { CHECK_DOCS_URL } from "@/lib/brand"
import { closingTileInPageGrid, closingTileInThemeGrid } from "@/lib/grid"
import { REPORT_SAMPLE } from "@/lib/report-sample"
import { exampleFor, promptUrls, themes } from "@/lib/themes"

const first = themes[0]

// One built page for each theme: the first of its prompts that has an example.
const pages = themes.flatMap((theme) => {
  const prompt = theme.prompts.find((p) => exampleFor(theme.slug, p.slug))
  return prompt
    ? [{ theme, prompt, urls: promptUrls(theme.slug, prompt.slug), count: theme.prompts.length }]
    : []
})

// The start of the site's own theme file, with the colors read from it.
const own = first?.spec.colors ?? {}
const excerpt = `---
name: Strict One
colors:
  primary: "${own.primary}"
  background: "${own.background}"
  foreground: "${own.foreground}"
typography:
  body:
    fontFamily: IBM Plex Sans
    fontSize: 16px
rounded:
  sm: 2px
  md: 4px
strict:
  contrast: AA
  colors:
    allow: tokens
  tells:
    purple-gradient: error
    emoji-icons: error
---

## Overview

Strict One is an editorial theme built on a
visible grid. Nothing is decorative.`

const steps = [
  {
    title: "One file",
    body: "A theme is a single DESIGN.md. Tokens sit at the top as YAML, and the reasoning behind them follows in plain prose. An agent reads both before it writes any UI.",
  },
  {
    title: "Any stack",
    body: "The same file exports to a shadcn registry item, a Tailwind CSS v4 theme, Nuxt UI, and W3C design tokens. Change the file and every export follows.",
  },
  {
    title: "Rules, not requests",
    body: "The strict block says what is allowed: which colors, which spacing, what contrast. The linter holds the theme to it, and Strict Check holds the pages an agent builds to it.",
  },
]

const roadmap = [
  {
    name: "Spec format and linter",
    body: "DESIGN.md plus a strict block, with exports for four targets.",
    status: "Built",
  },
  {
    name: "Free themes",
    body: "Eighteen themes with light and dark modes, served as a shadcn registry.",
    status: "Built",
  },
  {
    name: "Page prompts",
    body: "Full page briefs for a theme: a landing page, an essay, a dashboard, a shop and eighty-six more. Five for each of the eighteen themes, each with a preview of the page an agent built from it.",
    status: "In testing",
  },
  {
    name: "Generator",
    body: "Paste a URL, get a DESIGN.md that matches the site.",
    status: "Planned",
  },
  {
    name: "Strict Check",
    body: "Checks a project's code and rendered pages against a spec. A first version runs as a command, as an MCP server, as a skill for coding agents and as a job in a CI pipeline.",
    status: "In testing",
  },
  {
    name: "Agent UI kit",
    body: "Components for agent interfaces: tool calls, approvals, streaming states.",
    status: "Planned",
  },
]

// What Strict Check does, in three lines.
const checks = [
  {
    name: "The code",
    body: "Off-theme classes, hand-written colors, fonts the theme does not declare, gradients and emoji. No build, no browser: fast enough to run after every edit.",
  },
  {
    name: "The rendered pages",
    body: "Colors, contrast, type, spacing and corners as the browser draws them, in every color mode, on a laptop and on a phone.",
  },
  {
    name: "Where it runs",
    body: "As a command, as an MCP server and a skill for coding agents, and as a job in CI.",
  },
]

const promptCount = themes.reduce((sum, theme) => sum + theme.prompts.length, 0)

// The hero's backdrop repeats the page grid's columns out to both edges of the
// window. Sixty of them cover a window 5,800px wide; the number must be even,
// so that the middle twelve sit under the page grid.
const BACKDROP_COLUMNS = 60
---

<Layout
  title="Strict: themes and guardrails for AI-built UI"
  description="A Strict theme is one DESIGN.md file your coding agent reads and a linter checks. Eighteen free themes install into shadcn with one command."
>
  <section class="relative border-b border-border">
    <div aria-hidden="true" class="column-backdrop pointer-events-none absolute inset-0 hidden md:grid">
      {Array.from({ length: BACKDROP_COLUMNS }).map(() => <div class="bg-card/60" />)}
    </div>
    <div class="relative mx-auto grid max-w-page gap-8 px-4 py-16 md:grid-cols-12 md:px-8">
      <p class="label rise text-muted-foreground md:col-span-12">
        Themes and guardrails for AI-built UI
      </p>
      <h1 class="rise text-h1 md:col-span-10 md:text-display" style="--i:1">
        Give your coding agent a design system it has to follow.
      </h1>
      <p class="rise md:col-span-6" style="--i:2">
        A Strict theme is one DESIGN.md file: tokens an agent can read, rules a
        linter can check, and exports for shadcn, Tailwind and Nuxt UI. Eighteen
        themes and ninety page prompts, all free.
      </p>
      <div class="rise flex flex-wrap items-center gap-4 md:col-span-12" style="--i:3">
        <a
          href="/themes"
          class="label rounded-sm bg-primary px-4 py-2 text-primary-foreground hover:bg-primary/80"
        >
          Browse the themes
        </a>
        <a href="/spec" class="label text-primary underline underline-offset-4">
          Read the spec format
        </a>
      </div>
      {
        first && (
          <div class="rise min-w-0 md:col-span-8" style="--i:4">
            <Command command={first.installCommand} label={`Install ${first.name}`} />
          </div>
        )
      }
    </div>
  </section>

  <section class="mx-auto flex max-w-page flex-col gap-16 px-4 py-16 md:px-8">
    <SectionHeader number="01" label="Themes" title="Eighteen themes, free to use." />
    <p class="max-w-measure text-muted-foreground">
      Each one is a different job and a different look: a shop, a bank, a newspaper, a public
      service, a launch night. Every card below is drawn in its theme's own colors, fonts and
      corners.
    </p>
    <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        themes.map((theme) => (
          <li>
            <ThemeCard theme={theme} />
          </li>
        ))
      }
      <li class={closingTileInThemeGrid(themes.length)}>
        <MoreTile
          label="Your own"
          title="Or write the nineteenth."
          href="/spec"
          link="Read the spec format"
        >
          <p>
            A theme is one DESIGN.md file. The spec format says what goes in it, and the linter
            tells you where it is wrong before an agent ever reads it.
          </p>
        </MoreTile>
      </li>
    </ul>
    {
      first && (
        <article class="grid gap-8 md:grid-cols-12">
          <div class="flex flex-col gap-4 md:col-span-4">
            <p class="label text-muted-foreground">Stock components, one theme</p>
            <h3 class="text-h2">{first.name}, on shadcn</h3>
            <p class="text-muted-foreground">
              Nothing in this box is styled by hand. Install a theme and the components you
              already have take its colors, corners and fonts.
            </p>
            <a href="/themes" class="label text-primary underline underline-offset-4">
              See all eighteen this way
            </a>
          </div>
          <div class="md:col-span-8">
            <ThemePreview
              client:visible
              slug={first.slug}
              name={first.name}
              headingStyle={first.headingStyle}
              compact
            />
          </div>
        </article>
      )
    }
  </section>

  {
    pages.length > 0 && (
      <section class="mx-auto flex max-w-page flex-col gap-8 px-4 py-16 md:px-8">
        <SectionHeader
          number="02"
          label="Page prompts"
          title="Paste one prompt. Get a finished page."
        />
        <p class="max-w-measure text-muted-foreground">
          Every theme comes with five page prompts: full briefs for a landing page, an essay,
          a dashboard, a shop and more. The pages below were each built by a coding agent from
          one prompt, and are shown as they came out.
        </p>
        <ul class="grid gap-8 md:grid-cols-3">
          {pages.map(({ theme, prompt, urls, count }) => (
            <li class="flex flex-col gap-4">
              <PromptThumb href={urls.preview} src={urls.build} title={prompt.title} />
              <div class="flex flex-col gap-2">
                <p class="label text-muted-foreground">{theme.name}</p>
                <h3 class="text-h2">{prompt.title}</h3>
                <p class="flex flex-wrap gap-x-4 gap-y-2">
                  <a href={urls.preview} class="label text-primary underline underline-offset-4">
                    Preview<span class="sr-only"> the {prompt.title} page</span>
                  </a>
                  <a
                    href={`/themes/${theme.slug}`}
                    class="label text-primary underline underline-offset-4"
                  >
                    All {count} {theme.name} prompts
                  </a>
                </p>
              </div>
            </li>
          ))}
          <li class={closingTileInPageGrid(pages.length)}>
            <MoreTile
              label={`${promptCount} prompts`}
              title="Four more pages for every theme."
              href="/themes"
              link="Browse the themes"
            >
              <p>
                These are eighteen of the pages. Each theme's own page lists its five prompts,
                with the page an agent built from each one, and a button that copies the prompt.
              </p>
            </MoreTile>
          </li>
        </ul>
      </section>
    )
  }

  <section class="mx-auto flex max-w-page flex-col gap-16 px-4 py-16 md:px-8">
    <SectionHeader
      number={pages.length > 0 ? "03" : "02"}
      label="How it works"
      title="A theme your agent reads, and a linter checks."
    />
    <div class="grid gap-8 md:grid-cols-12">
      <ol class="flex flex-col gap-8 md:col-span-5">
        {
          steps.map((step, index) => (
            <li class="flex flex-col gap-2 border-t border-border pt-4">
              <p class="label text-muted-foreground">Step {index + 1}</p>
              <h3 class="text-h2">{step.title}</h3>
              <p class="text-muted-foreground">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="flex min-w-0 flex-col gap-2 md:col-span-6 md:col-start-7">
        <span class="label text-muted-foreground">DESIGN.md</span>
        <pre
          class="overflow-x-auto rounded-md border border-border bg-card p-4 text-body md:p-8"><code>{excerpt}</code></pre>
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-page flex-col gap-16 px-4 py-16 md:px-8">
    <SectionHeader
      number={pages.length > 0 ? "04" : "03"}
      label="Strict Check"
      title="Then check what the agent built."
      id="check"
    />
    <div class="grid gap-8 md:grid-cols-12">
      <div class="flex min-w-0 flex-col gap-8 md:col-span-5">
        <p class="text-muted-foreground">
          An agent that has read the theme can still drift from it. Strict Check reads the
          project's code, opens the built pages in a browser, and lists every color, size,
          space and corner that is not in the theme. Run it after each change, or let the
          agent run it and fix what it finds.
        </p>
        <Command command="npx @strictthemes/check . --dist dist" label="Run it in a project with a DESIGN.md" />
        <dl class="flex flex-col">
          {
            checks.map((item) => (
              <div class="flex flex-col gap-1 border-t border-border py-4">
                <dt class="label">{item.name}</dt>
                <dd class="text-muted-foreground">{item.body}</dd>
              </div>
            ))
          }
        </dl>
        <p>
          <a href={CHECK_DOCS_URL} class="label text-primary underline underline-offset-4">
            Read the Strict Check guide
          </a>
        </p>
      </div>
      <div class="flex min-w-0 flex-col gap-2 md:col-span-6 md:col-start-7">
        <span class="label text-muted-foreground">A report on a test page, shortened</span>
        {/* Long lines wrap, as they do in a terminal. On a phone the block scrolls sideways instead, to keep its columns. */}
        <pre
          tabindex="0"
          aria-label="A Strict Check report"
          class="overflow-x-auto rounded-md border border-border bg-card p-4 text-body md:p-8 md:whitespace-pre-wrap"><code>{REPORT_SAMPLE}</code></pre>
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-page flex-col gap-16 px-4 py-16 md:px-8">
    <SectionHeader
      number={pages.length > 0 ? "05" : "04"}
      label="Roadmap"
      title="What exists, and what is next."
    />
    <ul class="flex flex-col">
      {
        roadmap.map((item) => (
          <li class="grid gap-2 border-t border-border py-4 md:grid-cols-12 md:gap-8">
            <h3 class="font-sans font-semibold md:col-span-3">{item.name}</h3>
            <p class="text-muted-foreground md:col-span-7">{item.body}</p>
            <p
              class:list={[
                "label md:col-span-2 md:text-right",
                item.status === "Built" ? "text-foreground" : "text-muted-foreground",
              ]}
            >
              {item.status}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
