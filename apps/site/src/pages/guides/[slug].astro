---
// One guide: its facts, a list of its sections, and its text.
import type { GetStaticPaths } from "astro"

import Layout from "@/layouts/Base.astro"
import { guides, guideUrls, longDate, renderGuide, type Guide } from "@/lib/guides"

export const getStaticPaths: GetStaticPaths = () => guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }))

const { guide } = Astro.props as { guide: Guide }
const { html, contents } = renderGuide(guide)
const urls = guideUrls(guide.slug)
---

<Layout title={`${guide.title} | Strict`} description={guide.description}>
  <section class="border-b border-border">
    <div class="mx-auto grid max-w-page gap-8 px-4 py-16 md:grid-cols-12 md:px-8">
      <p class="label text-muted-foreground md:col-span-12">
        <a href="/guides/" class="hover:text-link">Guides</a> / {guide.kind}
      </p>
      <h1 class="text-h1 md:col-span-10 md:text-display">{guide.title}</h1>
      <p class="md:col-span-7">{guide.description}</p>
      <p class="label text-muted-foreground md:col-span-12">
        Last checked <time datetime={guide.checked}>{longDate(guide.checked)}</time>{guide.tool ? ` with ${guide.tool}` : ""}
      </p>
    </div>
  </section>
  <div class="mx-auto grid max-w-page gap-8 px-4 py-16 md:grid-cols-12 md:px-8">
    <nav aria-label="On this page" class="flex flex-col gap-2 md:sticky md:top-8 md:col-span-3 md:self-start">
      <p class="label text-muted-foreground">On this page</p>
      <ol class="flex flex-col border-t border-border">
        {
          contents.map((item, index) => (
            <li class="border-b border-border">
              <a href={`#${item.id}`} class="flex gap-4 py-2 hover:text-link">
                <span class="label py-1 text-muted-foreground">{String(index + 1).padStart(2, "0")}</span>
                <span>{item.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="pt-4">
        <a href={urls.markdown} class="label text-link underline underline-offset-4">This guide as Markdown</a>
      </p>
    </nav>
    <article class="prose min-w-0 md:col-span-8" set:html={html} />
  </div>
</Layout>
