---
// The guides: every one, the newest first, with a search field over their titles and text.
import Layout from "@/layouts/Base.astro"
import { guides, guideUrls, longDate } from "@/lib/guides"
---

<Layout
  title="Guides: design specs, themes and checks for agent-built UI | Strict"
  description="Step-by-step guides on DESIGN.md files, design tokens, themes and checking the UI a coding agent builds. Every command in them was run before it was written down."
>
  <section class="border-b border-border">
    <div class="mx-auto grid max-w-page gap-8 px-4 py-16 md:grid-cols-12 md:px-8">
      <p class="label text-muted-foreground md:col-span-12">Guides</p>
      <h1 class="text-h1 md:col-span-9 md:text-display">How to keep agent-built UI on your design.</h1>
      <p class="md:col-span-6">
        Step-by-step guides on design specs, tokens, themes and checks. Every command in a
        guide was run before it was written down, and each guide says when, and with which
        version.
      </p>
    </div>
  </section>

  <div class="mx-auto flex max-w-page flex-col gap-8 px-4 py-16 md:px-8">
    <form role="search" class="flex flex-col gap-2 md:w-1/2" data-guide-search>
      <label for="guide-search" class="label text-muted-foreground">Search the guides</label>
      <input
        id="guide-search"
        name="q"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="For example: dark mode, contrast, shadcn"
        aria-describedby="guide-search-count"
        class="w-full rounded-sm border border-muted-foreground bg-background px-4 py-2 text-foreground placeholder:text-muted-foreground"
      />
      <p id="guide-search-count" class="label text-muted-foreground" role="status">{guides.length} guides</p>
    </form>

    <ul class="flex flex-col border-t border-border" data-guide-list>
      {
        guides.map((guide) => (
          <li class="border-b border-border" data-slug={guide.slug} data-head={`${guide.title} ${guide.description} ${guide.kind}`}>
            <a href={guideUrls(guide.slug).page} class="group grid gap-2 py-8 md:grid-cols-12 md:gap-8">
              <span class="label py-1 text-muted-foreground md:col-span-2">{guide.kind}</span>
              <span class="flex flex-col gap-2 md:col-span-7">
                <span class="font-heading text-h2 wrap-break-word group-hover:text-link" data-title>{guide.title}</span>
                <span class="text-muted-foreground">{guide.description}</span>
                <span class="text-muted-foreground wrap-break-word" data-snippet hidden />
              </span>
              <span class="label py-1 text-muted-foreground md:col-span-3 md:text-right">
                <time datetime={guide.date}>{longDate(guide.date)}</time>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<script>
  import { guideSearch } from "@/lib/guide-search"

  guideSearch()
</script>
