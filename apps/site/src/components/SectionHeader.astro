---
interface Props {
  number: string
  label: string
  title: string
}

const { number, label, title } = Astro.props
---

<div class="grid gap-4 border-t border-foreground pt-4 md:grid-cols-12 md:gap-8">
  <p class="label text-muted-foreground md:col-span-3">
    <span class="text-foreground">{number}</span> / {label}
  </p>
  <h2 class="text-h1 md:col-span-9">{title}</h2>
</div>
