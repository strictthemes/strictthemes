---
import { MARK_PATH } from "@/lib/brand"

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

{/* The mark takes the primary color of the theme the page wears. */}
<svg
  viewBox="0 0 32 32"
  aria-hidden="true"
  class:list={["shrink-0", className]}
>
  <rect width="32" height="32" class="fill-primary"></rect>
  <path d={MARK_PATH} class="fill-primary-foreground"></path>
</svg>
