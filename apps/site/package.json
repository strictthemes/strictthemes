{
  "name": "@strictthemes/site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-examples.ts && node scripts/build-kit.ts",
    "brand": "node scripts/build-brand.ts",
    "strict-check": "node ../../packages/check/dist/cli.js . --spec ../../packages/themes/themes/strict-one/DESIGN.md --dist dist --exclude examples --exclude .kit --mode light --path / --path /themes/ --path /spec/ --path /themes/strict-one/ --path /kit/ --path /kit/strict-one/ --path /guides/ --path /guides/design-md-from-your-site/ --path /404.html",
    "strict-check:kit": "node scripts/check-kit.ts",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "test": "astro build && node scripts/build-examples.ts && node scripts/build-kit.ts && node --test \"test/*.test.ts\""
  },
